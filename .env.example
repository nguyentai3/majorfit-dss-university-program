# Environment configuration for deployment
# Copy this file to .env.local and fill in your actual values

# App Configuration
APP_URL=https://your-app-domain.com
VITE_APP_URL=https://your-app-domain.com
NODE_ENV=production

# Database (MAMP MySQL)
# Option A (recommended): full Prisma connection string
DATABASE_URL=mysql://root:root@127.0.0.1:8889/majorfit

# Option B: DB_* parts (app/scripts will auto-build DATABASE_URL if missing)
# DB_HOST=127.0.0.1
# DB_PORT=8889
# DB_USER=root
# DB_PASS=root
# DB_NAME=majorfit

# Authentication/JWT (required)
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_EMAILS=admin@majorfit.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
DEFAULT_USER_EMAIL=test@gmail.com
DEFAULT_USER_PASSWORD=123456
# Optional: show demo banner in local UI
# VITE_DEMO_MODE=false

# AI Providers (Choose one)
# Hugging Face (free tier)
HUGGINGFACE_API_KEY=your_huggingface_api_key
# Cohere (free tier)
COHERE_API_KEY=your_cohere_api_key
# Ollama (self-hosted)
OLLAMA_BASE_URL=http://localhost:11434
# Default provider
DEFAULT_AI_PROVIDER=huggingface

# Google Maps (optional)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
