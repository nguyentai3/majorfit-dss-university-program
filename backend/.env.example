PORT=8000
NODE_ENV=development

# Backend CORS
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_EMAILS=admin@majorfit.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
DEFAULT_USER_EMAIL=test@gmail.com
DEFAULT_USER_PASSWORD=123456
# Optional comma-separated override
# FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3001

# JWT auth
JWT_SECRET=replace-this-with-a-long-random-secret

# MAMP MySQL
DB_HOST=127.0.0.1
DB_PORT=8889
DB_USER=root
DB_PASS=root
DB_NAME=majorfit

# Optional direct URL (overrides DB_* if set)
# DATABASE_URL=mysql://root:root@127.0.0.1:8889/majorfit

# Step 2 AI program analysis
AI_PROVIDER=manual-ai
# OpenAI-compatible example:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# Groq example:
# AI_PROVIDER=groq
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TEMPERATURE=0.2
AI_DIRECT_ENABLED=false
# AI_API_KEY=

# Optional fallback provider when the primary provider is rate-limited or temporarily unavailable
AI_FALLBACK_ENABLED=true
# AI_FALLBACK_PROVIDER=openai-compatible
# AI_FALLBACK_BASE_URL=https://api.openai.com/v1
# AI_FALLBACK_MODEL=gpt-4o-mini
# AI_FALLBACK_API_KEY=
