# Optional if you don't want to use Vite proxy.
# By default frontend calls /api and Vite proxies to http://localhost:8000
# VITE_API_BASE_URL=http://localhost:8000/api

# Optional dev proxy target override
# VITE_PROXY_TARGET=http://localhost:8000

# Admin emails shown in frontend menu and route guard
# VITE_ADMIN_EMAILS=admin@majorfit.local
